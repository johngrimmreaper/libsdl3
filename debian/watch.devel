version=4
opts="\
    compression=xz, \
    dversionmangle=s/\+(?:git)?[0-9]*(?:\+g[0-9a-f]*)(?:\+(?:dfsg|ds)[0-9]*)//, \
    downloadurlmangle=s#/tag/#/download/#;s#((?:pre)?release-?@ANY_VERSION@)$#$1/SDL3-$2.tar.xz#, \
    filenamemangle=s#(?:pre)?release-?@ANY_VERSION@#SDL3-$1.tar.xz#, \
    repack, \
    repacksuffix=+ds" \
https://github.com/libsdl-org/SDL/tags .*/releases/tag/(?:pre)?release-?@ANY_VERSION@
