From: Anonymous Maarten <anonymous.maarten@gmail.com>
Date: Sun, 26 Oct 2025 21:38:43 +0100
Subject: cmake: SDL_process on unix needs vfork symbol

Current FIL-C toolchains don't have vfork

Origin: upstream, 3.3.3, commit:766532948e883e5ae04d8b34a35f4fa1c78d927e
---
 CMakeLists.txt | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c29d266..53a94f1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3452,7 +3452,10 @@ int main(void)
     return 0;
 }
 " HAVE_POSIX_SPAWN)
-  if(HAVE_POSIX_SPAWN)
+  if(NOT APPLE)
+    check_symbol_exists(vfork "unistd.h" LIBC_HAS_VFORK)
+  endif()
+  if(HAVE_POSIX_SPAWN AND (APPLE OR LIBC_HAS_VFORK))
     sdl_glob_sources(
       "${SDL3_SOURCE_DIR}/src/process/posix/*.c"
       "${SDL3_SOURCE_DIR}/src/process/posix/*.h"
